{
  "opensearch": {
    "host": "${OPENSEARCH_HOST}",
    "username": "${OPENSEARCH_USER}",
    "password": "${OPENSEARCH_PASSWORD}",
    "verify_certs": false,
    "timeout": 30,
    "max_retries": 3
  },
  "indices": {
    "raw_logs": {
      "pattern": "wazuh-infraspeak*",
      "company_id_field": "data.entities",
      "location_filter": "/logs/nginx/api.production.access.log"
    },
    "metrics": {
      "name": "metrics-tpr",
      "create_if_missing": true
    }
  },
  "observation_windows": {
    "enabled": [
      60,
      30,
      10
    ]
  },
  "execution_schedule": {
    "windows": {
      "10": [
        0,
        10,
        20,
        30,
        40,
        50
      ],
      "30": [
        0,
        30
      ],
      "60": [
        0
      ]
    }
  },
  "metrics": {
    "layers": {
      "L1": {
        "enabled": true,
        "save_schedule": {
          "10": "always",
          "30": [
            0,
            30
          ],
          "60": [
            0
          ]
        },
        "patterns": {
          "bot_detection": "bot|crawler|spider|scraper"
        }
      },
      "L2": {
        "enabled": true,
        "dimensions": [
          "user",
          "route"
        ],
        "save_schedule": {
          "10": "always",
          "30": [
            0,
            30
          ],
          "60": [
            0
          ]
        },
        "keywords": {
          "admin_endpoints": "admin|config|setup|root|dashboard",
          "sensitive_data": "billing|finance|salary|payments|cpf|nif|ssn|credit_card|passport",
          "backup_files": "backup|dump|archive|tar.gz|zip|sql|bak",
          "export_operations": "export|download|report|csv|xlsx|pdf",
          "bulk_operations": "batch|bulk|multi|mass"
        },
        "thresholds": {
          "working_hours_start": 8,
          "working_hours_end": 19,
          "unusual_account_threshold_pct": 5.0
        },
        "account_types": [
          "admin",
          "manager",
          "technician",
          "user"
        ]
      }
    }
  },
  "detection": {
    "enabled": true,
    "parallel_layers": true,
    "hierarchical_drill_down": true,
    "min_score_for_alert": 0.05,
    "risk_scoring": {
      "enabled": true,
      "threshold": 0.15,
      "weights": {
        "l1": 0.25,
        "l2_user": 0.5,
        "l2_route": 0.25
      }
    },
    "min_samples_for_detection": 10,
    "cluster_prediction": {
      "enabled": true,
      "lookback_days": 7,
      "min_windows_required": 24,
      "cache_enabled": true,
      "cache_ttl_minutes": 60,
      "cache_max_entities": 1000
    }
  },
  "models": {
    "observation_window": 60,
    "entity_models_path": "models/entity_models/60min",
    "cluster_models_path": "models/cluster_models/60min",
    "user_models_path": "models/user_models/60min",
    "route_models_path": "models/route_models/60min",
    "n_clusters": 3
  },
  "logging": {
    "level": "INFO",
    "file": "${LOG_FILE}",
    "anomaly_file": "${ANOMALY_LOG_FILE}",
    "max_size_mb": 100,
    "backup_count": 5,
    "enable_file_logging": false
  },
  "performance": {
    "max_execution_time_seconds": 1200,
    "batch_size": 10000,
    "max_logs_per_fetch": 100000
  },
  "features": {
    "log_detection_runs": true
  },
  "warmup": {
    "enabled": true,
    "start_date": "2025-11-01T00:00:00Z",
    "end_date": "2025-12-15T00:00:00Z",
    "chunk_hours": 3,
    "max_workers": 8
  }
}