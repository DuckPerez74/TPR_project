<!--
  TPR Anomaly Detection Rules
  Copyright (C) 2025
  
  Rules for TPR Wodle events: 100000 - 100099
  
  These rules process events from the TPR anomaly detection wodle,
  which sends events via socket with integration=tpr.
-->

<group name="tpr,anomaly_detection,">

  <!-- Base TPR event - level 0 (no alert) -->
  <rule id="100000" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">tpr</field>
    <options>no_full_log</options>
    <description>TPR Anomaly Detection event.</description>
  </rule>

  <!-- ==================== ANOMALY DETECTION RULES ==================== -->

  <!-- L1 Anomaly Detected - Low Risk (8% - 20%) -->
  <rule id="100001" level="5">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L1</field>
    <field name="tpr.risk_score" type="pcre2">^([89]|1[0-9])(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L1 Anomaly (Low Risk) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l1,low_risk,</group>
  </rule>

  <!-- L1 Anomaly - Moderate Risk (20% - 40%) -->
  <rule id="100002" level="7">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L1</field>
    <field name="tpr.risk_score" type="pcre2">^([23][0-9])(\\.[0-9]+)?$</field>
   <options>no_full_log</options>
    <description>TPR L1 Anomaly (Moderate Risk) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l1,moderate_risk,</group>
  </rule>

  <!-- L1 Anomaly - High Risk (40% - 60%) -->
  <rule id="100003" level="10">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L1</field>
    <field name="tpr.risk_score" type="pcre2">^([45][0-9])(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L1 Anomaly (High Risk) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l1,high_risk,</group>
  </rule>

  <!-- L1 Anomaly - Critical Risk (> 60%) -->
  <rule id="100004" level="12">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L1</field>
    <field name="tpr.risk_score" type="pcre2">^([6-9][0-9]|100)(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L1 Anomaly (CRITICAL) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>tpr_anomaly,layer_l1,critical_risk,</group>
  </rule>

  <!-- L1 Anomaly - Fallback (any L1 anomaly not matched above) -->
  <rule id="100005" level="5">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L1</field>
    <options>no_full_log</options>
    <description>TPR L1 Anomaly - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l1,</group>
  </rule>

  <!-- ==================== L2 ANOMALY RULES (USER + ROUTE) ==================== -->

  <!-- L2 Anomaly - Low Risk (8% - 20%) -->
  <rule id="100010" level="5">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L2</field>
    <field name="tpr.risk_score" type="pcre2">^([89]|1[0-9])(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L2 Anomaly (Low Risk) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l2,low_risk,</group>
  </rule>

  <!-- L2 Anomaly - Moderate Risk (20% - 40%) -->
  <rule id="100011" level="7">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L2</field>
    <field name="tpr.risk_score" type="pcre2">^([23][0-9])(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L2 Anomaly (Moderate Risk) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l2,moderate_risk,</group>
  </rule>

  <!-- L2 Anomaly - High Risk (40% - 60%) -->
  <rule id="100012" level="10">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L2</field>
    <field name="tpr.risk_score" type="pcre2">^([45][0-9])(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L2 Anomaly (High Risk) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l2,high_risk,</group>
  </rule>

  <!-- L2 Anomaly - Critical Risk (> 60%) -->
  <rule id="100013" level="12">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L2</field>
    <field name="tpr.risk_score" type="pcre2">^([6-9][0-9]|100)(\\.[0-9]+)?$</field>
    <options>no_full_log</options>
    <description>TPR L2 Anomaly (CRITICAL) - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>tpr_anomaly,layer_l2,critical_risk,</group>
  </rule>

  <!-- L2 Anomaly - Fallback -->
  <rule id="100014" level="5">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">anomaly</field>
    <field name="tpr.layer">L2</field>
    <options>no_full_log</options>
    <description>TPR L2 Anomaly - Entity $(tpr.entity_id) - Risk $(tpr.risk_score)%</description>
    <group>tpr_anomaly,layer_l2,</group>
  </rule>

  <!-- ==================== LLM ANALYSIS RULES ==================== -->

  <!-- LLM Analysis - Normal Activity -->
  <rule id="100020" level="3">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">llm_analysis</field>
    <field name="tpr.classification">Normal Activity</field>
    <options>no_full_log</options>
    <description>TPR LLM Analysis - Normal Activity - Entity $(tpr.entity_id)</description>
    <group>tpr_llm,normal_activity,</group>
  </rule>

  <!-- LLM Analysis - Suspicious Activity -->
  <rule id="100021" level="7">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">llm_analysis</field>
    <field name="tpr.classification">Suspicious</field>
    <options>no_full_log</options>
    <description>TPR LLM Analysis - Suspicious Activity - Entity $(tpr.entity_id) - Type: $(tpr.threat_type)</description>
    <group>tpr_llm,suspicious_activity,</group>
  </rule>

  <!-- LLM Analysis - Likely Attack -->
  <rule id="100022" level="12">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">llm_analysis</field>
    <field name="tpr.classification">Likely Attack</field>
    <options>no_full_log</options>
    <description>TPR LLM Analysis - LIKELY ATTACK - Entity $(tpr.entity_id) - Type: $(tpr.threat_type)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>tpr_llm,likely_attack,attack,</group>
  </rule>

  <!-- LLM Analysis - Unknown Classification (fallback) -->
  <rule id="100029" level="5">
    <if_sid>100000</if_sid>
    <field name="tpr.event_type">llm_analysis</field>
    <options>no_full_log</options>
    <description>TPR LLM Analysis - Entity $(tpr.entity_id) - Classification: $(tpr.classification)</description>
    <group>tpr_llm,</group>
  </rule>

</group>
