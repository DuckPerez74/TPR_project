#!/bin/sh
# TPR Wodle - Threat Pattern Recognition
# Shell wrapper for Wazuh integration
# This program is free software; you can redistribute it and/or modify it under the terms of GPLv2

SCRIPT_PATH_NAME="$0"
DIR_NAME="$(cd $(dirname ${SCRIPT_PATH_NAME}); pwd -P)"
SCRIPT_NAME="$(basename ${SCRIPT_PATH_NAME})"

PYTHON_SCRIPT="${DIR_NAME}/${SCRIPT_NAME}.py"
LOG_FILE="${DIR_NAME}/tpr_debug.log"

# Change to script directory (for .env and relative paths)
cd "${DIR_NAME}"

# Log execution attempt with timestamp
echo "=== $(date) ===" >> "${LOG_FILE}"
echo "DIR_NAME: ${DIR_NAME}" >> "${LOG_FILE}"
echo "PYTHON_SCRIPT: ${PYTHON_SCRIPT}" >> "${LOG_FILE}"
echo "User: $(whoami)" >> "${LOG_FILE}"
echo "PATH: ${PATH}" >> "${LOG_FILE}"

# Use absolute path to Python, capture all output
/usr/bin/python3 ${PYTHON_SCRIPT} "$@" >> "${LOG_FILE}" 2>&1
EXIT_CODE=$?

echo "Exit code: ${EXIT_CODE}" >> "${LOG_FILE}"
echo "" >> "${LOG_FILE}"

exit ${EXIT_CODE}
