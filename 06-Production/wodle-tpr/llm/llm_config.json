{
    "enabled": true,
    "provider": "anthropic",
    "model": "claude-sonnet-4-5-20250929",
    "api_key_env": "ANTHROPIC_API_KEY",
    "trigger_on_window": 10,
    "min_risk_score_for_analysis": 0.6,
    "max_tokens_response": 1500,
    "timeout_seconds": 30,
    "temperature": 0.2,
    "rate_limit": {
        "max_calls_per_hour": 100,
        "max_calls_per_day": 1000
    },
    "retry": {
        "max_retries": 3,
        "backoff_seconds": 2
    }
}